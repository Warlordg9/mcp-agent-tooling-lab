[
 {
  "name": "consult_search_slots",
  "kind": "own",
  "description": "Ищет слоты консультаций преподавателей курса на один день с фильтрами по формату, теме и преподавателю. Используй, когда студент хочет найти свободное время консультации или выбрать слот перед записью. Не используй для записи (consult_book), для просмотра своих броней (consult_list_bookings) и для вопросов о расписании лекций, дедлайнах и оценках — этих данных здесь нет. Если на день ничего нет, ответ подскажет ближайшие дни со слотами.",
  "parameters": {
   "type": "object",
   "properties": {
    "date": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
     "description": "День консультации в формате YYYY-MM-DD, например 2026-10-14. Расписание есть на 2026-10-12 — 2026-10-23."
    },
    "format": {
     "type": "string",
     "enum": [
      "online",
      "offline"
     ],
     "description": "Формат встречи: online (видеосвязь) или offline (аудитория). Не указывай, если формат не важен."
    },
    "topic": {
     "type": "string",
     "enum": [
      "homework",
      "project",
      "exam",
      "lecture"
     ],
     "description": "Тема: homework — домашние задания, project — курсовой проект, exam — подготовка к экзамену, lecture — вопросы по лекциям."
    },
    "teacher": {
     "type": "string",
     "enum": [
      "ivanova",
      "petrov",
      "sidorova",
      "kuznetsov",
      "smirnova"
     ],
     "description": "Преподаватель по фамилии латиницей: ivanova, petrov, sidorova, kuznetsov, smirnova."
    },
    "only_free": {
     "type": "boolean",
     "default": true,
     "description": "true — только слоты со свободными местами (по умолчанию); false — все слоты дня."
    },
    "limit": {
     "type": "integer",
     "minimum": 1,
     "maximum": 20,
     "default": 5,
     "description": "Сколько слотов вернуть за раз, 1–20 (по умолчанию 5)."
    },
    "cursor": {
     "type": "string",
     "minLength": 1,
     "description": "Handle следующей страницы (next_cursor из прошлого ответа с теми же фильтрами). Для первой страницы не передавай."
    },
    "response_format": {
     "type": "string",
     "enum": [
      "concise",
      "detailed"
     ],
     "default": "concise",
     "description": "concise — короткие строки с идентификаторами (по умолчанию, экономит токены); detailed — JSON со всеми полями: аудитория или ссылка, темы, вместимость, правила."
    }
   },
   "required": [
    "date"
   ],
   "additionalProperties": false
  }
 },
 {
  "name": "consult_get_slot",
  "kind": "own",
  "description": "Возвращает карточку одного слота по slot_id: время, длительность, формат, аудиторию или ссылку, темы и свободные места. Используй, чтобы уточнить детали уже найденного слота перед записью. Не используй для поиска по дате или преподавателю (consult_search_slots) и для статуса брони (consult_get_booking).",
  "parameters": {
   "type": "object",
   "properties": {
    "slot_id": {
     "type": "string",
     "pattern": "^s-\\d{4}-[a-z]{3}-\\d{4}$",
     "description": "Идентификатор слота из результата consult_search_slots, например s-1014-iva-1000."
    },
    "response_format": {
     "type": "string",
     "enum": [
      "concise",
      "detailed"
     ],
     "default": "concise",
     "description": "concise — короткие строки с идентификаторами (по умолчанию, экономит токены); detailed — JSON со всеми полями: аудитория или ссылка, темы, вместимость, правила."
    }
   },
   "required": [
    "slot_id"
   ],
   "additionalProperties": false
  }
 },
 {
  "name": "consult_book",
  "kind": "own",
  "description": "Записывает студента на выбранный слот и возвращает booking_id и статус active. Используй только после того, как студент явно выбрал слот и подтвердил запись. Не используй для поиска времени (consult_search_slots), переноса без отмены старой брони и записи другого студента. Повтор с тем же idempotency_key не создаёт дубль.",
  "parameters": {
   "type": "object",
   "properties": {
    "slot_id": {
     "type": "string",
     "pattern": "^s-\\d{4}-[a-z]{3}-\\d{4}$",
     "description": "Идентификатор слота из результата consult_search_slots, например s-1014-iva-1000."
    },
    "student_id": {
     "type": "string",
     "pattern": "^st-\\d{4}$",
     "description": "Идентификатор студента, от чьего имени действует агент, например st-1001."
    },
    "topic": {
     "type": "string",
     "enum": [
      "homework",
      "project",
      "exam",
      "lecture"
     ],
     "description": "Тема консультации; должна входить в темы слота: homework, project, exam или lecture."
    },
    "idempotency_key": {
     "type": "string",
     "minLength": 8,
     "maxLength": 64,
     "description": "Уникальная строка на одну попытку записи (8–64 символа). При повторе той же записи передай тот же ключ."
    },
    "response_format": {
     "type": "string",
     "enum": [
      "concise",
      "detailed"
     ],
     "default": "concise",
     "description": "concise — короткие строки с идентификаторами (по умолчанию, экономит токены); detailed — JSON со всеми полями: аудитория или ссылка, темы, вместимость, правила."
    }
   },
   "required": [
    "slot_id",
    "student_id",
    "topic",
    "idempotency_key"
   ],
   "additionalProperties": false
  }
 },
 {
  "name": "consult_get_booking",
  "kind": "own",
  "description": "Возвращает бронь студента по booking_id: слот, тему и статус (active или cancelled). Используй, чтобы проверить результат consult_book или consult_cancel. Не используй для поиска свободных слотов и для списка всех броней (consult_list_bookings).",
  "parameters": {
   "type": "object",
   "properties": {
    "booking_id": {
     "type": "string",
     "pattern": "^b-[0-9a-f]{8}$",
     "description": "Handle брони, который вернул consult_book или consult_list_bookings, например b-1a2b3c4d."
    },
    "student_id": {
     "type": "string",
     "pattern": "^st-\\d{4}$",
     "description": "Идентификатор студента, от чьего имени действует агент, например st-1001."
    },
    "response_format": {
     "type": "string",
     "enum": [
      "concise",
      "detailed"
     ],
     "default": "concise",
     "description": "concise — короткие строки с идентификаторами (по умолчанию, экономит токены); detailed — JSON со всеми полями: аудитория или ссылка, темы, вместимость, правила."
    }
   },
   "required": [
    "booking_id",
    "student_id"
   ],
   "additionalProperties": false
  }
 },
 {
  "name": "consult_list_bookings",
  "kind": "own",
  "description": "Показывает брони консультаций одного студента с фильтром по статусу. Используй, когда студент спрашивает, на какие консультации он записан, или нужно найти booking_id для отмены. Не используй для поиска свободного времени (consult_search_slots) и для броней других студентов.",
  "parameters": {
   "type": "object",
   "properties": {
    "student_id": {
     "type": "string",
     "pattern": "^st-\\d{4}$",
     "description": "Идентификатор студента, от чьего имени действует агент, например st-1001."
    },
    "status": {
     "type": "string",
     "enum": [
      "active",
      "cancelled",
      "all"
     ],
     "default": "active",
     "description": "active — действующие брони (по умолчанию), cancelled — отменённые, all — все."
    },
    "response_format": {
     "type": "string",
     "enum": [
      "concise",
      "detailed"
     ],
     "default": "concise",
     "description": "concise — короткие строки с идентификаторами (по умолчанию, экономит токены); detailed — JSON со всеми полями: аудитория или ссылка, темы, вместимость, правила."
    }
   },
   "required": [
    "student_id"
   ],
   "additionalProperties": false
  }
 },
